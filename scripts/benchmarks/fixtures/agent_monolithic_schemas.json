  {
    "type": "function",
    "function": {
      "name": "create_boolean_geometry",
      "description": "Create a CAD boolean geometry from inline primitive operands.\n\nArgs:\n    name: Geometry name.\n    operation: Cut (first minus rest), fuse, or intersect.\n    operands: At least two objects with primitive, parameters,\n        and optional origin {x, y, z}. Concentric annulus example:\n        [{\"primitive\":\"disk\",\"parameters\":{\"radius\":2}},\n         {\"primitive\":\"disk\",\"parameters\":{\"radius\":1}}].\n    units: Length units for every operand.\n",
      "parameters": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "operands": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Operands",
            "type": "array"
          },
          "operation": {
            "enum": [
              "cut",
              "fuse",
              "intersect"
            ],
            "title": "Operation",
            "type": "string"
          },
          "units": {
            "default": "mm",
            "enum": [
              "mm",
              "cm",
              "m",
              "in"
            ],
            "title": "Units",
            "type": "string"
          }
        },
        "required": [
          "name",
          "operation",
          "operands"
        ],
        "title": "create_boolean_geometry_input",
        "type": "object"
      }
    }
  },
