  {
    "type": "function",
    "function": {
      "name": "mesh_uploaded_geometry",
      "description": "Import STEP then mesh through dependency-aware jobs, only with explicit settings.\n\nArgs:\n    file_id: Project-owned uploaded STEP ID, never a path.\n    min_size: User-approved minimum size in size_units.\n    max_size: User-approved maximum size in size_units.\n    size_units: Explicit user-approved mesh size units; never infer from bounds or filename.\n    element_family: User-approved triangular/quadrilateral (2D) or tetrahedral (3D).\n",
      "parameters": {
        "properties": {
          "element_family": {
            "anyOf": [
              {
                "enum": [
                  "line",
                  "triangular",
                  "quadrilateral",
                  "tetrahedral",
                  "hexahedral"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Element Family"
          },
          "file_id": {
            "title": "File Id",
            "type": "string"
          },
          "max_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Size"
          },
          "min_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Size"
          },
          "size_units": {
            "anyOf": [
              {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Size Units"
          }
        },
        "required": [
          "file_id"
        ],
        "title": "mesh_uploaded_geometry_input",
        "type": "object"
      }
    }
  },
